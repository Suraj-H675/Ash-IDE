node_modules/
.cache/
.tmp/
out/
# Node-gyp and Cargo create local build products inside native package roots.
# Do not publish host-generated Makefiles, absolute-path config.gypi, or binaries.
/native/**/build/
/native/**/target/
# Docker-built Wayland clipboard helper and fingerprint are local packaging outputs.
/native/wayland-clipboard/.build/
dist/
# Only the top-level output directory is a release artifact. Nested
# config/scripts/release/ contains source and must be included in provenance.
/release/
.turbo/
coverage/
playwright-report/
test-results/
.DS_Store
.env
.env.*
!.env.example
.agents/
.aws/
.codex/
.audit/

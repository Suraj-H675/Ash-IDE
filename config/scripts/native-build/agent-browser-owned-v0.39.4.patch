@@ -1245,10 +1245,156 @@ fn send_command_once(cmd: &Value, session: &str) -> Result<Response, SendError>
 
     let stream = connect(session).map_err(SendError::NotSent)?;
 
+    send_command_on_stream(cmd, stream, json_str.as_bytes())
+}
+
+#[cfg(target_os = "linux")]
+pub(crate) fn owned_deadline(
+    cmd: &Value,
+    close_timeout_ms: Option<u64>,
+) -> Result<Instant, String> {
+    let budget = close_timeout_ms
+        .map(Duration::from_millis)
+        .unwrap_or_else(|| read_timeout_for(cmd));
+    // Match the parent's non-wrapping Node timer ceiling. Do not silently
+    // shorten a legitimate operation's requested deadline.
+    if budget.is_zero() || budget.as_millis() > i32::MAX as u128 {
+        return Err("Owned command timeout exceeds the supported budget".to_string());
+    }
+    Instant::now()
+        .checked_add(budget)
+        .ok_or_else(|| "Owned command deadline overflow".to_string())
+}
+
+#[cfg(target_os = "linux")]
+fn remaining_owned_time(deadline: Instant) -> std::io::Result<Duration> {
+    deadline
+        .checked_duration_since(Instant::now())
+        .filter(|remaining| !remaining.is_zero())
+        .map(|remaining| remaining.max(Duration::from_micros(1)))
+        .ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::TimedOut,
+                "Owned command deadline exceeded",
+            )
+        })
+}
+
+#[cfg(target_os = "linux")]
+pub(crate) fn connect_owned_endpoint(
+    path: &std::path::Path,
+    deadline: Instant,
+) -> std::io::Result<UnixStream> {
+    use socket2::{Domain, SockAddr, Socket, Type};
+    remaining_owned_time(deadline)?;
+    let socket = Socket::new(Domain::UNIX, Type::STREAM, None)?;
+    socket.set_nonblocking(true)?;
+    // Linux AF_UNIX returns EAGAIN when the accept queue is full. Fail
+    // closed instead of blocking, retrying, or opening another stream.
+    socket.connect(&SockAddr::unix(path)?)?;
+    remaining_owned_time(deadline)?;
+    socket.set_nonblocking(false)?;
+    Ok(socket.into())
+}
+
+#[cfg(target_os = "linux")]
+struct OwnedDeadlineStream {
+    stream: UnixStream,
+    deadline: Instant,
+    write_deadline: Instant,
+}
+
+#[cfg(target_os = "linux")]
+impl Read for OwnedDeadlineStream {
+    fn read(&mut self, buffer: &mut [u8]) -> std::io::Result<usize> {
+        // Each kernel call gets only the remaining total budget; a partial
+        // frame or EINTR cannot reset the deadline.
+        self.stream
+            .set_read_timeout(Some(remaining_owned_time(self.deadline)?))?;
+        self.stream.read(buffer)
+    }
+}
+
+#[cfg(target_os = "linux")]
+impl Write for OwnedDeadlineStream {
+    fn write(&mut self, buffer: &[u8]) -> std::io::Result<usize> {
+        self.stream
+            .set_write_timeout(Some(remaining_owned_time(self.write_deadline)?))?;
+        self.stream.write(buffer)
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        self.stream.flush()
+    }
+}
+
+#[cfg(target_os = "linux")]
+pub(crate) fn send_command_over_owned_stream(
+    cmd: Value,
+    stream: UnixStream,
+    deadline: Instant,
+) -> Response {
+    let expected_id = match cmd.get("id").and_then(Value::as_str) {
+        Some(id) if !id.is_empty() => id.to_string(),
+        _ => {
+            return Response {
+                success: false,
+                error: Some("Owned command is missing its request ID".to_string()),
+                code: Some("ash_owned_invalid_command".to_string()),
+                ..Default::default()
+            }
+        }
+    };
+    let mut json_str = match serde_json::to_string(&cmd) {
+        Ok(json) => json,
+        Err(error) => {
+            return Response {
+                success: false,
+                error: Some(format!("Failed to serialize command: {error}")),
+                code: Some("ash_owned_send_failed".to_string()),
+                ..Default::default()
+            }

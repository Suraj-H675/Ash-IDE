+use serde::Deserialize;
+use serde_json::Value;
+use std::fs;
+use std::path::{Path, PathBuf};
+
+use crate::connection::Response;
+use crate::validation::is_valid_session_name;
+
+pub const MODE_FLAG: &str = "--ash-native-attach-only-v1";
+pub const CAPABILITIES_FLAG: &str = "--ash-native-capabilities";
+pub const CAPABILITY_MARKER: &str = "ash.native.attach-only.linux.v1";
+const MAX_RECEIPT_BYTES: u64 = 16 * 1024;
+const MIN_CLOSE_TIMEOUT_MS: u64 = 100_000;
+// The Ash parent uses Node timers, whose maximum non-wrapping delay is i32::MAX ms.
+const MAX_CLOSE_TIMEOUT_MS: u64 = i32::MAX as u64;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ModeError {
+    MissingReceipt,
+    MarkerPosition,
+}
+
+impl ModeError {
+    pub fn code(self) -> &'static str {
+        match self {
+            Self::MissingReceipt => "ash_owned_invalid_receipt",
+            Self::MarkerPosition => "ash_owned_invalid_invocation",
+        }
+    }
+
+    pub fn message(self) -> &'static str {
+        match self {
+            Self::MissingReceipt => "Ash attach-only mode requires an absolute owner receipt path",
+            Self::MarkerPosition => {
+                "Ash native client markers are valid only as the first argument"
+            }
+        }
+    }
+}
+
+pub fn extract_mode(args: &mut Vec<String>) -> Result<Option<PathBuf>, ModeError> {
+    let receipt_path = if args.first().map(String::as_str) == Some(MODE_FLAG) {
+        if args.len() < 2 {
+            return Err(ModeError::MissingReceipt);
+        }
+        let path = PathBuf::from(args[1].clone());
+        args.drain(0..2);
+        Some(path)
+    } else {
+        None
+    };
+    if args
+        .iter()
+        .any(|arg| arg == MODE_FLAG || arg == CAPABILITIES_FLAG)
+    {
+        return Err(ModeError::MarkerPosition);
+    }
+    Ok(receipt_path)
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields, rename_all = "camelCase")]
+struct OwnedSessionReceipt {
+    marker: String,
+    version: u32,
+    session: String,
+    socket_path: PathBuf,
+    pid: u32,
+    uid: u32,
+    boot_id: String,
+    start_ticks: u64,
+    socket_dev: u64,
+    socket_ino: u64,
+    #[serde(default)]
+    close_request_id: Option<String>,
+    #[serde(default)]
+    close_timeout_ms: Option<u64>,
+}
+
+#[cfg(target_os = "linux")]
+pub struct AttachOnlyClient {
+    session: String,
+    socket_path: PathBuf,
+    process: crate::ash_owned_identity::ProcessIdentity,
+    socket: crate::ash_owned_identity::SocketIdentity,
+    socket_directory: crate::ash_owned_identity::DirectoryIdentity,
+    close_request_id: Option<String>,
+    close_timeout_ms: u64,
+}
+
+#[cfg(not(target_os = "linux"))]
+pub struct AttachOnlyClient;
+
+#[cfg(not(target_os = "linux"))]
+impl AttachOnlyClient {
+    pub fn session(&self) -> &str {
+        ""
+    }
+
+    pub fn socket_path(&self) -> &Path {
+        Path::new("")
+    }
+
+    pub fn close_request_id(&self) -> Option<&str> {
+        None
+    }
+
+    pub fn send(&self, _command: Value) -> Response {
+        rejected(
+            "ash_owned_unsupported_platform",
+            "Ash attach-only mode is currently supported only on Linux",
+        )
+    }
+
+    pub fn send_in_batch(&self, command: Value, _deadline: Option<std::time::Instant>) -> Response {
+        self.send(command)
+    }
+}
+
+#[cfg(target_os = "linux")]
+impl AttachOnlyClient {
+    pub fn load(path: &Path) -> Result<Self, String> {
+        use std::io::Read;
+        use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+
+        if !path.is_absolute() {
+            return Err("Owner receipt path must be absolute".to_string());
+        }
+        let file = fs::OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_CLOEXEC | libc::O_NONBLOCK)
+            .open(path)
+            .map_err(|_| "Owner receipt is missing or unavailable".to_string())?;
+        let metadata = file
+            .metadata()
+            .map_err(|_| "Owner receipt metadata is unavailable".to_string())?;
+        let uid = unsafe { libc::geteuid() };
+        if !metadata.is_file()
+            || metadata.uid() != uid
+            || metadata.mode() & 0o077 != 0
+            || metadata.nlink() != 1
+            || metadata.len() > MAX_RECEIPT_BYTES
+        {
+            return Err(
+                "Owner receipt must be a private regular file owned by this user".to_string(),
+            );
+        }
+        let mut contents = Vec::new();
+        file.take(MAX_RECEIPT_BYTES + 1)
+            .read_to_end(&mut contents)
+            .map_err(|_| "Owner receipt could not be read".to_string())?;
+        if contents.len() as u64 > MAX_RECEIPT_BYTES {
+            return Err("Owner receipt exceeds its size limit".to_string());
+        }
+        let receipt: OwnedSessionReceipt = serde_json::from_slice(&contents)
+            .map_err(|_| "Owner receipt is invalid JSON or has an unknown shape".to_string())?;
+        if receipt.marker != CAPABILITY_MARKER
+            || receipt.version != 1
+            || !is_valid_session_name(&receipt.session)
+            || !receipt.socket_path.is_absolute()
+            || receipt.pid == 0
+            || receipt.uid != uid
+            || receipt.boot_id.is_empty()
+            || receipt.start_ticks == 0
+            || receipt.socket_ino == 0
+            || receipt
+                .close_request_id
+                .as_ref()
+                .is_some_and(|id| !is_uuid_text(id))
+            || receipt.close_timeout_ms.is_some_and(|timeout| {
+                receipt.close_request_id.is_none()
+                    || !(MIN_CLOSE_TIMEOUT_MS..=MAX_CLOSE_TIMEOUT_MS).contains(&timeout)
+            })
+        {
+            return Err(
+                "Owner receipt is incomplete or belongs to another client version".to_string(),
+            );
+        }
+
+        let socket_parent = receipt
+            .socket_path
+            .parent()
+            .ok_or_else(|| "Owner socket path has no parent directory".to_string())?;
+        if socket_parent
+            .canonicalize()
+            .map_err(|_| "Owner socket directory is missing or unavailable".to_string())?
+            != socket_parent
+        {
+            return Err(
+                "Owner socket path must use a canonical, non-symlink directory".to_string(),
+            );
+        }
+        let parent = crate::ash_owned_identity::private_directory_identity(socket_parent)
+            .map_err(|_| "Owner socket directory is missing or unavailable".to_string())?;
+        if parent.uid != uid || parent.mode & 0o077 != 0 {
+            return Err(
+                "Owner socket directory must be private and owned by this user".to_string(),
+            );
+        }
+
+        Ok(Self {
+            session: receipt.session,
+            socket_path: receipt.socket_path,
+            process: crate::ash_owned_identity::ProcessIdentity {
+                pid: receipt.pid,
+                uid: receipt.uid,
+                boot_id: receipt.boot_id,
+                start_ticks: receipt.start_ticks,
+            },
+            socket: crate::ash_owned_identity::SocketIdentity {
+                dev: receipt.socket_dev,
+                ino: receipt.socket_ino,
+                uid: receipt.uid,
+            },
+            socket_directory: parent,
+            close_request_id: receipt.close_request_id,
+            close_timeout_ms: receipt.close_timeout_ms.unwrap_or(MIN_CLOSE_TIMEOUT_MS),
+        })
+    }
+
+    pub fn session(&self) -> &str {
+        &self.session
+    }
+
+    pub fn socket_path(&self) -> &Path {
+        &self.socket_path
+    }
+
+    pub fn close_request_id(&self) -> Option<&str> {
+        self.close_request_id.as_deref()
+    }
+
+    pub fn send(&self, command: Value) -> Response {
+        self.send_in_batch(command, None)
+    }
+
+    pub fn send_in_batch(&self, command: Value, deadline: Option<std::time::Instant>) -> Response {
+        self.send_with_hook(command, deadline, || {})
+    }
+
+    fn send_with_hook(
+        &self,
+        command: Value,
+        batch_deadline: Option<std::time::Instant>,
+        before_proof: impl FnOnce(),
+    ) -> Response {
+        use std::os::fd::AsRawFd;
+
+        let action = command
+            .get("action")
+            .and_then(Value::as_str)
+            .unwrap_or_default();
+        if crate::ash_owned_identity::is_management_command("", action, false) {
+            return rejected(
+                "ash_owned_management_rejected",
+                "This command is not available in Ash attach-only mode",
+            );
+        }
+        if action == "close" {
+            let Some(expected_id) = self.close_request_id.as_deref() else {
+                return rejected(
+                    "ash_owned_close_intent_required",
+                    "Owned close requires a durable close request ID in the owner receipt",
+                );
+            };
+            if command.get("id").and_then(Value::as_str) != Some(expected_id) {
+                return rejected(
+                    "ash_owned_invalid_command",
+                    "Owned close request ID does not match the owner receipt",
+                );
+            }
+        } else if self.close_request_id.is_some() {
+            return rejected(
+                "ash_owned_close_in_progress",
+                "The owner receipt is fenced for close; browser actions are no longer admitted",
+            );
+        }
+        let close_timeout = (action == "close").then_some(self.close_timeout_ms);
+        let deadline = match crate::connection::owned_deadline(&command, close_timeout) {
+            Ok(deadline) => deadline,
+            Err(error) => return rejected("ash_owned_invalid_command", error),
+        };
+        let deadline = batch_deadline.map_or(deadline, |batch| batch.min(deadline));
+        if deadline <= std::time::Instant::now() {
+            return rejected(
+                "ash_owned_batch_deadline_exceeded",
+                "Owned batch deadline expired before dispatch",
+            );
+        }
+        match crate::ash_owned_identity::private_directory_identity(
+            self.socket_path.parent().unwrap_or_else(|| Path::new("/")),
+        )
+        .and_then(|actual| {
+            crate::ash_owned_identity::validate_private_directory(
+                self.socket_directory,
+                actual,
+                self.process.uid,
+            )
+        })
+        .and_then(|()| crate::ash_owned_identity::socket_identity(&self.socket_path))
+        .and_then(|actual| crate::ash_owned_identity::validate_socket(self.socket, actual))
+        {
+            Ok(()) => {}
+            Err(error) => return proof_rejected(error),
+        }
+
+        let stream = match crate::connection::connect_owned_endpoint(&self.socket_path, deadline) {
+            Ok(stream) => stream,
+            Err(error) => {
+                let code = if error.kind() == std::io::ErrorKind::NotFound
+                    || error.kind() == std::io::ErrorKind::ConnectionRefused
+                {
+                    "ash_owned_endpoint_missing"
+                } else {
+                    "ash_owned_connect_failed"
+                };
+                return rejected(
+                    code,
+                    format!("Could not connect to the owned daemon: {error}"),
+                );
+            }
+        };
+
+        before_proof();
+
+        let peer = peer_credentials(stream.as_raw_fd());
+        let (peer_pid, peer_uid) = match peer {
+            Ok(peer) => peer,
+            Err(error) => return rejected("ash_owned_peer_unavailable", error),
+        };
+        let actual = match process_identity(peer_pid) {
+            Ok(actual) => actual,
+            Err(error) => return rejected("ash_owned_peer_unavailable", error),
+        };
+        if let Err(error) = crate::ash_owned_identity::validate_process(
+            &self.process,
+            peer_pid,
+            peer_uid,
+            &actual.boot_id,
+            actual.start_ticks,
+            actual.uid,
+        ) {
+            return proof_rejected(error);
+        }
+        match crate::ash_owned_identity::private_directory_identity(
+            self.socket_path.parent().unwrap_or_else(|| Path::new("/")),
+        )
+        .and_then(|actual| {
+            crate::ash_owned_identity::validate_private_directory(
+                self.socket_directory,
+                actual,
+                self.process.uid,
+            )
+        })
+        .and_then(|()| crate::ash_owned_identity::socket_identity(&self.socket_path))
+        .and_then(|actual| crate::ash_owned_identity::validate_socket(self.socket, actual))
+        {
+            Ok(()) => {}
+            Err(error) => return proof_rejected(error),
+        }
+
+        crate::connection::send_command_over_owned_stream(command, stream, deadline)
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn peer_credentials(fd: std::os::fd::RawFd) -> Result<(u32, u32), String> {
+    let mut credentials = std::mem::MaybeUninit::<libc::ucred>::uninit();
+    let mut length = std::mem::size_of::<libc::ucred>() as libc::socklen_t;
+    let result = unsafe {
+        libc::getsockopt(
+            fd,
+            libc::SOL_SOCKET,
+            libc::SO_PEERCRED,
+            credentials.as_mut_ptr().cast(),
+            &mut length,
+        )
+    };
+    if result != 0 || length as usize != std::mem::size_of::<libc::ucred>() {
+        return Err("SO_PEERCRED was unavailable on the connected socket".to_string());
+    }
+    let credentials = unsafe { credentials.assume_init() };
+    if credentials.pid <= 0 {
+        return Err("SO_PEERCRED returned an invalid peer PID".to_string());
+    }
+    Ok((credentials.pid as u32, credentials.uid))
+}
+
+#[cfg(target_os = "linux")]
+fn process_identity(pid: u32) -> Result<crate::ash_owned_identity::ProcessIdentity, String> {
+    let proc_root = PathBuf::from(format!("/proc/{pid}"));
+    let stat = fs::read_to_string(proc_root.join("stat"))
+        .map_err(|_| "The connected daemon process start time is unavailable".to_string())?;
+    let start_ticks = crate::ash_owned_identity::parse_linux_start_ticks(&stat)
+        .ok_or_else(|| "The connected daemon process start time is malformed".to_string())?;
+    let status = fs::read_to_string(proc_root.join("status"))
+        .map_err(|_| "The connected daemon process UID is unavailable".to_string())?;
+    let uid = crate::ash_owned_identity::parse_linux_effective_uid(&status)
+        .ok_or_else(|| "The connected daemon process UID is malformed".to_string())?;
+    let confirm_stat = fs::read_to_string(proc_root.join("stat")).map_err(|_| {
+        "The connected daemon process identity changed during verification".to_string()
+    })?;
+    if crate::ash_owned_identity::parse_linux_start_ticks(&confirm_stat) != Some(start_ticks) {
+        return Err(
+            "The connected daemon process identity changed during verification".to_string(),
+        );
+    }
+    let boot_id = fs::read_to_string("/proc/sys/kernel/random/boot_id")
+        .map_err(|_| "The current Linux boot identity is unavailable".to_string())?
+        .trim()
+        .to_string();
+    Ok(crate::ash_owned_identity::ProcessIdentity {
+        pid,
+        uid,
+        boot_id,
+        start_ticks,
+    })
+}
+
+fn is_uuid_text(value: &str) -> bool {
+    value.len() == 36
+        && value.bytes().enumerate().all(|(index, byte)| match index {
+            8 | 13 | 18 | 23 => byte == b'-',
+            _ => byte.is_ascii_hexdigit(),
+        })
+}
+
+#[cfg(target_os = "linux")]
+fn proof_rejected(error: crate::ash_owned_identity::ProofError) -> Response {
+    let message = match error {
+        crate::ash_owned_identity::ProofError::PeerPid
+        | crate::ash_owned_identity::ProofError::PeerUid => {
+            "Connected socket peer does not match the Ash owner receipt"
+        }
+        crate::ash_owned_identity::ProofError::BootId
+        | crate::ash_owned_identity::ProofError::StartTicks
+        | crate::ash_owned_identity::ProofError::ProcessUid => {
+            "Connected socket peer process incarnation does not match the Ash owner receipt"
+        }
+        crate::ash_owned_identity::ProofError::SocketMissing => "Owned daemon socket is missing",
+        crate::ash_owned_identity::ProofError::SocketType
+        | crate::ash_owned_identity::ProofError::SocketIdentity
+        | crate::ash_owned_identity::ProofError::SocketUid => {
+            "Owned daemon socket path no longer identifies the recorded endpoint"
+        }
+    };
+    rejected(error.code(), message)
+}
+
+fn rejected(code: &str, message: impl Into<String>) -> Response {
+    Response {
+        success: false,
+        data: None,
+        error: Some(message.into()),
+        code: Some(code.to_string()),
+        warning: None,
+    }
+}
+
+pub fn capabilities_json() -> Value {
+    serde_json::json!({
+        "capability": CAPABILITY_MARKER,
+        "version": 1,
+        "platform": if cfg!(target_os = "linux") { "linux" } else { "unsupported" },
+        "attachOnly": cfg!(target_os = "linux"),
+        "explicitTargetAddressing": cfg!(target_os = "linux"),
+        "strictTabBinding": cfg!(target_os = "linux"),
+        "bootstrap": false
+    })
+}

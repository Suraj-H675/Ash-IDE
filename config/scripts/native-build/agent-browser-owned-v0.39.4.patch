+    #[test]
+    fn owned_deadline_rejects_slow_trickled_frame() {
+        let (client, mut server) = UnixStream::pair().unwrap();
+        let worker = thread::spawn(move || {
+            let mut request = String::new();
+            BufReader::new(&mut server).read_line(&mut request).unwrap();
+            assert_eq!(request, "request\n");
+            // A normal per-read timeout would be renewed by each byte and
+            // ultimately accept this response well after the total budget.
+            for byte in b"{\"id\":\"test\",\"success\":true}\n" {
+                if server.write_all(&[*byte]).is_err() {
+                    break;
+                }
+                thread::sleep(Duration::from_millis(30));
+            }
+        });
+        let started = Instant::now();
+        let deadline = started + Duration::from_millis(150);
+        let result = exchange_owned(
+            OwnedDeadlineStream {
+                stream: client,
+                deadline,
+                write_deadline: deadline,
+            },
+            b"request\n",
+            "test",
+        );
+        assert!(matches!(result, Err(SendError::OutcomeUnknown(_))));
+        assert!(started.elapsed() < Duration::from_secs(2));
+        worker.join().unwrap();
+    }

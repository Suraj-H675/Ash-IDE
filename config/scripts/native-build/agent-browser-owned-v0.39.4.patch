+#[cfg(all(test, target_os = "linux"))]
+mod tests {
+    use super::*;
+    use std::io::{BufRead, Read, Write};
+    use std::os::unix::fs::PermissionsExt;
+    use std::os::unix::net::UnixListener;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+    fn fixture(name: &str) -> (AttachOnlyClient, UnixListener, PathBuf) {
+        use std::os::unix::fs::MetadataExt;
+
+        let unique = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let directory =
+            std::env::temp_dir().join(format!("ash-owned-client-{}-{unique}", std::process::id()));
+        fs::create_dir(&directory).unwrap();
+        fs::set_permissions(&directory, fs::Permissions::from_mode(0o700)).unwrap();
+        let socket_path = directory.join(format!("{name}.sock"));
+        let listener = UnixListener::bind(&socket_path).unwrap();
+        let process = process_identity(std::process::id()).unwrap();
+        let socket_metadata = fs::symlink_metadata(&socket_path).unwrap();
+        let directory_metadata = fs::symlink_metadata(&directory).unwrap();
+        let client = AttachOnlyClient {
+            session: "ash-test-session".to_string(),
+            socket_path,
+            process,
+            socket: crate::ash_owned_identity::SocketIdentity {
+                dev: socket_metadata.dev(),
+                ino: socket_metadata.ino(),
+                uid: socket_metadata.uid(),
+            },
+            socket_directory: crate::ash_owned_identity::DirectoryIdentity {
+                dev: directory_metadata.dev(),
+                ino: directory_metadata.ino(),
+                uid: directory_metadata.uid(),
+                mode: directory_metadata.mode(),
+            },
+            close_request_id: None,
+            close_timeout_ms: MIN_CLOSE_TIMEOUT_MS,
+        };
+        (client, listener, directory)
+    }
+
+    #[test]
+    fn advertised_marker_is_private_and_linux_scoped() {
+        let value = capabilities_json();
+        assert_eq!(value["capability"], CAPABILITY_MARKER);
+        assert_eq!(value["version"], 1);
+        assert_eq!(value["bootstrap"], false);
+        assert_eq!(value["strictTabBinding"], true);
+    }
+
+    #[test]
+    fn normal_cli_arguments_do_not_select_attach_only_mode() {
+        let mut args = vec!["open".to_string(), "https://example.test".to_string()];
+        assert_eq!(extract_mode(&mut args), Ok(None));
+        assert_eq!(
+            args,
+            vec!["open".to_string(), "https://example.test".to_string()]
+        );
+    }
+
+    #[test]
+    fn attach_only_mode_requires_a_first_argument_receipt() {
+        let mut missing = vec![MODE_FLAG.to_string()];
+        assert_eq!(extract_mode(&mut missing), Err(ModeError::MissingReceipt));
+
+        let mut misplaced = vec![
+            "open".to_string(),
+            MODE_FLAG.to_string(),
+            "/owner.json".to_string(),
+        ];
+        assert_eq!(extract_mode(&mut misplaced), Err(ModeError::MarkerPosition));
+    }
+
+    #[test]
+    fn attach_only_mode_removes_only_its_private_wrapper_arguments() {
+        let mut args = vec![
+            MODE_FLAG.to_string(),
+            "/private/owner.json".to_string(),
+            "--json".to_string(),
+            "open".to_string(),
+            "https://example.test".to_string(),
+        ];
+        assert_eq!(
+            extract_mode(&mut args),
+            Ok(Some(PathBuf::from("/private/owner.json")))
+        );
+        assert_eq!(
+            args,
+            vec![
+                "--json".to_string(),
+                "open".to_string(),
+                "https://example.test".to_string()
+            ]
+        );
+    }
+
+    #[test]
+    fn connected_same_peer_receives_one_browser_request() {
+        let (client, listener, directory) = fixture("same-peer");
+        let server = std::thread::spawn(move || {
+            let (mut stream, _) = listener.accept().unwrap();
+            let mut request = String::new();
+            std::io::BufReader::new(&mut stream)
+                .read_line(&mut request)
+                .unwrap();
+            assert!(request.contains("\"action\":\"tab_list\""));
+            stream
+                .write_all(b"{\"id\":\"test\",\"success\":true,\"data\":{\"tabs\":[]}}\n")
+                .unwrap();
+        });
+        let response = client.send(serde_json::json!({ "id": "test", "action": "tab_list" }));
+        server.join().unwrap();
+        assert!(response.success);
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+
+    #[test]
+    fn wrong_peer_is_rejected_before_any_request_bytes() {
+        let (mut client, listener, directory) = fixture("wrong-peer");
+        client.process.pid = client.process.pid.saturating_add(1);
+        let server = std::thread::spawn(move || {
+            let (mut stream, _) = listener.accept().unwrap();
+            let mut request = Vec::new();
+            stream.read_to_end(&mut request).unwrap();
+            request
+        });
+        let response = client.send(serde_json::json!({ "id": "test", "action": "tab_list" }));
+        assert_eq!(response.code.as_deref(), Some("ash_owned_peer_mismatch"));
+        assert!(server.join().unwrap().is_empty());
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+
+    #[test]
+    fn replacement_after_connect_fails_before_the_original_peer_receives_bytes() {
+        let (client, original, directory) = fixture("replace");
+        let path = client.socket_path.clone();
+        let original_path = path.with_extension("original");
+        let replacement_path = path.clone();
+        let response = client.send_with_hook(
+            serde_json::json!({ "id": "test", "action": "tab_list" }),
+            None,
+            move || {
+                std::fs::rename(&replacement_path, &original_path).unwrap();
+                UnixListener::bind(&replacement_path).unwrap();
+            },
+        );
+        assert_eq!(
+            response.code.as_deref(),
+            Some("ash_owned_endpoint_replaced")
+        );
+        let (mut accepted, _) = original.accept().unwrap();
+        let mut request = Vec::new();
+        accepted.read_to_end(&mut request).unwrap();
+        assert!(request.is_empty());
+        drop(original);
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+
+    #[test]
+    fn attach_only_send_does_not_replay_an_uncertain_read() {
+        let (client, listener, directory) = fixture("no-retry");
+        let accepts = std::sync::Arc::new(AtomicUsize::new(0));
+        let server_accepts = accepts.clone();
+        let server = std::thread::spawn(move || {
+            let (mut stream, _) = listener.accept().unwrap();
+            server_accepts.fetch_add(1, Ordering::SeqCst);
+            let mut request = String::new();
+            std::io::BufReader::new(&mut stream)
+                .read_line(&mut request)
+                .unwrap();
+            drop(stream);
+            listener.set_nonblocking(true).unwrap();
+            let deadline = std::time::Instant::now() + Duration::from_millis(450);
+            while std::time::Instant::now() < deadline {
+                match listener.accept() {
+                    Ok((mut extra, _)) => {
+                        server_accepts.fetch_add(1, Ordering::SeqCst);
+                        let mut request = String::new();
+                        let _ = std::io::BufReader::new(&mut extra).read_line(&mut request);
+                    }
+                    Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                        std::thread::sleep(Duration::from_millis(10));
+                    }
+                    Err(error) => panic!("unexpected listener error: {error}"),
+                }
+            }
+        });
+        let response = client.send(serde_json::json!({ "id": "test", "action": "tab_list" }));
+        server.join().unwrap();
+        assert_eq!(response.code.as_deref(), Some("outcome_unknown"));
+        assert_eq!(accepts.load(Ordering::SeqCst), 1);
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+
+    #[test]
+    fn close_requires_the_receipt_request_id_and_returns_only_its_ack() {
+        let (mut client, listener, directory) = fixture("close-id");
+        client.close_request_id = Some("123e4567-e89b-12d3-a456-426614174000".to_string());
+        let wrong_id = client.send(serde_json::json!({ "id": "generated", "action": "close" }));
+        assert_eq!(wrong_id.code.as_deref(), Some("ash_owned_invalid_command"));
+        let fenced = client.send(serde_json::json!({ "id": "test", "action": "tab_list" }));
+        assert_eq!(fenced.code.as_deref(), Some("ash_owned_close_in_progress"));
+        listener.set_nonblocking(true).unwrap();
+        assert_eq!(
+            listener.accept().unwrap_err().kind(),
+            std::io::ErrorKind::WouldBlock
+        );
+        listener.set_nonblocking(false).unwrap();
+        let server = std::thread::spawn(move || {
+            let (mut stream, _) = listener.accept().unwrap();
+            let mut request = String::new();
+            std::io::BufReader::new(&mut stream)
+                .read_line(&mut request)
+                .unwrap();
+            assert!(request.contains("\"id\":\"123e4567-e89b-12d3-a456-426614174000\""));
+            assert!(request.contains("\"action\":\"close\""));
+            stream
+                .write_all(b"{\"id\":\"123e4567-e89b-12d3-a456-426614174000\",\"success\":true,\"data\":{\"closed\":true}}\n")
+                .unwrap();
+        });
+        let response = client.send(
+            serde_json::json!({ "id": "123e4567-e89b-12d3-a456-426614174000", "action": "close" }),
+        );
+        server.join().unwrap();
+        assert!(response.success);
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+
+    #[test]
+    fn close_without_durable_intent_never_connects() {
+        let (client, listener, directory) = fixture("close-no-intent");
+        let response = client.send(serde_json::json!({ "id": "generated", "action": "close" }));
+        assert_eq!(
+            response.code.as_deref(),
+            Some("ash_owned_close_intent_required")
+        );
+        listener.set_nonblocking(true).unwrap();
+        assert_eq!(
+            listener.accept().unwrap_err().kind(),
+            std::io::ErrorKind::WouldBlock
+        );
+        drop(listener);
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+
+    #[test]
+    fn owned_batch_shares_one_deadline_and_never_sends_after_expiry() {
+        let (client, listener, directory) = fixture("batch-deadline");
+        let server = std::thread::spawn(move || {
+            for (id, delay) in [("first", 100), ("second", 350)] {
+                let (mut stream, _) = listener.accept().unwrap();
+                let mut request = String::new();
+                std::io::BufReader::new(&mut stream)
+                    .read_line(&mut request)
+                    .unwrap();
+                assert!(request.contains(&format!("\"id\":\"{id}\"")));
+                std::thread::sleep(Duration::from_millis(delay));
+                let reply = format!("{{\"id\":\"{id}\",\"success\":true}}\n");
+                let _ = stream.write_all(reply.as_bytes());
+            }
+            listener.set_nonblocking(true).unwrap();
+            assert_eq!(
+                listener.accept().unwrap_err().kind(),
+                std::io::ErrorKind::WouldBlock
+            );
+        });
+        let deadline = std::time::Instant::now() + Duration::from_millis(300);
+        assert!(
+            client
+                .send_in_batch(
+                    serde_json::json!({"id":"first","action":"tab_list"}),
+                    Some(deadline)
+                )
+                .success
+        );
+        let second = client.send_in_batch(
+            serde_json::json!({"id":"second","action":"tab_list"}),
+            Some(deadline),
+        );
+        assert_eq!(second.code.as_deref(), Some("outcome_unknown"));
+        let third = client.send_in_batch(
+            serde_json::json!({"id":"third","action":"tab_list"}),
+            Some(deadline),
+        );
+        assert_eq!(
+            third.code.as_deref(),
+            Some("ash_owned_batch_deadline_exceeded")
+        );
+        server.join().unwrap();
+        std::fs::remove_dir_all(directory).unwrap();
+    }
+}

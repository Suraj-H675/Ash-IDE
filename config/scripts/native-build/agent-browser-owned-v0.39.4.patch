+#[cfg(target_os = "linux")]
+fn exchange_owned<S: Read + Write>(
+    mut stream: S,
+    request: &[u8],
+    expected_id: &str,
+) -> Result<Response, SendError> {
+    let mut written = 0;
+    while written < request.len() {
+        let err = match stream.write(&request[written..]) {
+            Ok(0) => std::io::Error::from(std::io::ErrorKind::WriteZero),
+            Ok(n) => {
+                written += n;
+                continue;
+            }
+            Err(e) if e.kind() == std::io::ErrorKind::Interrupted => continue,
+            Err(e) => e,
+        };
+        let message = format!("Failed to send: {err}");
+        return Err(if written == 0 {
+            SendError::NotSent(message)
+        } else {
+            SendError::OutcomeUnknown(message)
+        });
+    }
+
+    read_owned_response(stream, expected_id, 50 * 1024 * 1024)
+}
+
+#[cfg(target_os = "linux")]
+fn read_owned_response<R: Read>(
+    stream: R,
+    expected_id: &str,
+    max_bytes: usize,
+) -> Result<Response, SendError> {
+    let mut reader = BufReader::new(stream).take(max_bytes as u64 + 1);
+    let mut response_line = Vec::new();
+    reader
+        .read_until(b'\n', &mut response_line)
+        .map_err(|error| SendError::OutcomeUnknown(format!("Failed to read: {error}")))?;
+    if response_line.len() > max_bytes || response_line.last() != Some(&b'\n') {
+        return Err(SendError::OutcomeUnknown(
+            "Owned response exceeded its bound or lacked a complete frame".to_string(),
+        ));
+    }
+    let response_value: Value = serde_json::from_slice(&response_line)
+        .map_err(|error| SendError::OutcomeUnknown(format!("Invalid response: {error}")))?;
+    if response_value.get("id").and_then(Value::as_str) != Some(expected_id) {
+        return Err(SendError::OutcomeUnknown(
+            "Response request ID did not match the owned command".to_string(),
+        ));
+    }
+    serde_json::from_value(response_value)
+        .map_err(|error| SendError::OutcomeUnknown(format!("Invalid response: {error}")))
+}

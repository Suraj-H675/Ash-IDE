+use std::fs;
+use std::os::unix::fs::{FileTypeExt, MetadataExt};
+use std::path::Path;
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ProcessIdentity {
+    pub pid: u32,
+    pub uid: u32,
+    pub boot_id: String,
+    pub start_ticks: u64,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct SocketIdentity {
+    pub dev: u64,
+    pub ino: u64,
+    pub uid: u32,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct DirectoryIdentity {
+    pub dev: u64,
+    pub ino: u64,
+    pub uid: u32,
+    pub mode: u32,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ProofError {
+    PeerPid,
+    PeerUid,
+    BootId,
+    StartTicks,
+    ProcessUid,
+    SocketMissing,
+    SocketType,
+    SocketIdentity,
+    SocketUid,
+}
+
+impl ProofError {
+    pub fn code(self) -> &'static str {
+        match self {
+            Self::PeerPid | Self::PeerUid => "ash_owned_peer_mismatch",
+            Self::BootId | Self::StartTicks | Self::ProcessUid => "ash_owned_incarnation_mismatch",
+            Self::SocketMissing => "ash_owned_endpoint_missing",
+            Self::SocketType | Self::SocketIdentity | Self::SocketUid => {
+                "ash_owned_endpoint_replaced"
+            }
+        }
+    }
+}
+
+pub fn validate_process(
+    expected: &ProcessIdentity,
+    peer_pid: u32,
+    peer_uid: u32,
+    actual_boot_id: &str,
+    actual_start_ticks: u64,
+    proc_uid: u32,
+) -> Result<(), ProofError> {
+    if peer_pid != expected.pid {
+        return Err(ProofError::PeerPid);
+    }
+    if peer_uid != expected.uid {
+        return Err(ProofError::PeerUid);
+    }
+    if actual_boot_id != expected.boot_id {
+        return Err(ProofError::BootId);
+    }
+    if actual_start_ticks != expected.start_ticks {
+        return Err(ProofError::StartTicks);
+    }
+    if proc_uid != expected.uid {
+        return Err(ProofError::ProcessUid);
+    }
+    Ok(())
+}
+
+pub fn socket_identity(path: &Path) -> Result<SocketIdentity, ProofError> {
+    let metadata = fs::symlink_metadata(path).map_err(|_| ProofError::SocketMissing)?;
+    if !metadata.file_type().is_socket() {
+        return Err(ProofError::SocketType);
+    }
+    Ok(SocketIdentity {
+        dev: metadata.dev(),
+        ino: metadata.ino(),
+        uid: metadata.uid(),
+    })
+}
+
+pub fn private_directory_identity(path: &Path) -> Result<DirectoryIdentity, ProofError> {
+    let metadata = fs::symlink_metadata(path).map_err(|_| ProofError::SocketMissing)?;
+    if !metadata.is_dir() || metadata.file_type().is_symlink() {
+        return Err(ProofError::SocketType);
+    }
+    Ok(DirectoryIdentity {
+        dev: metadata.dev(),
+        ino: metadata.ino(),
+        uid: metadata.uid(),
+        mode: metadata.mode(),
+    })
+}
+
+pub fn validate_private_directory(
+    expected: DirectoryIdentity,
+    actual: DirectoryIdentity,
+    uid: u32,
+) -> Result<(), ProofError> {
+    if actual.uid != uid || actual.mode & 0o077 != 0 {
+        return Err(ProofError::SocketUid);
+    }
+    if actual.dev != expected.dev || actual.ino != expected.ino {
+        return Err(ProofError::SocketIdentity);
+    }
+    Ok(())
+}
+
+pub fn validate_socket(expected: SocketIdentity, actual: SocketIdentity) -> Result<(), ProofError> {
+    if actual.uid != expected.uid {
+        return Err(ProofError::SocketUid);
+    }
+    if actual.dev != expected.dev || actual.ino != expected.ino {
+        return Err(ProofError::SocketIdentity);
+    }
+    Ok(())
+}
+
+pub fn parse_linux_start_ticks(stat: &str) -> Option<u64> {
+    let command_end = stat.rfind(')')?;
+    let fields = stat.get(command_end + 1..)?.split_whitespace();
+    fields.skip(19).next()?.parse().ok()
+}
+
+pub fn parse_linux_effective_uid(status: &str) -> Option<u32> {
+    let uid_line = status.lines().find_map(|line| line.strip_prefix("Uid:"))?;
+    uid_line.split_whitespace().nth(1)?.parse().ok()
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum InvocationError {
+    SessionMismatch,
+    Namespace,
+    LaunchOptions,
+    RestoreOptions,
+    DaemonConfig,
+}
+
+impl InvocationError {
+    pub fn code(self) -> &'static str {
+        match self {
+            Self::SessionMismatch | Self::Namespace => "ash_owned_target_mismatch",
+            Self::LaunchOptions | Self::RestoreOptions | Self::DaemonConfig => {
+                "ash_owned_option_rejected"
+            }
+        }
+    }
+}
+
+pub fn validate_invocation_options(
+    expected_session: &str,
+    requested_session: &str,
+    namespace: Option<&str>,
+    launch_options: bool,
+    restore_options: bool,
+    daemon_config: bool,
+) -> Result<(), InvocationError> {
+    if requested_session != expected_session {
+        return Err(InvocationError::SessionMismatch);
+    }
+    if namespace.is_some_and(|value| !value.is_empty()) {
+        return Err(InvocationError::Namespace);
+    }
+    if launch_options {
+        return Err(InvocationError::LaunchOptions);
+    }
+    if restore_options {
+        return Err(InvocationError::RestoreOptions);
+    }
+    if daemon_config {
+        return Err(InvocationError::DaemonConfig);
+    }
+    Ok(())
+}
+
+pub fn is_management_command(root: &str, action: &str, close_all: bool) -> bool {
+    close_all
+        || matches!(
+            root,
+            "chat"
+                | "dashboard"
+                | "doctor"
+                | "install"
+                | "mcp"
+                | "plugin"
+                | "plugins"
+                | "profiles"
+                | "session"
+                | "skills"
+                | "upgrade"
+                | "read"
+                | "connect"
+        )
+        || action == "launch"
+        || matches!(action, "batch" | "read" | "connect" | "cdp_url")
+        || matches!(action, "reconfigure" | "restart" | "shutdown" | "kill")
+        || action.starts_with("state_")
+        || action.starts_with("session_")
+        || action.starts_with("dashboard_")
+        || action.starts_with("auth_")
+        || action.starts_with("plugin_")
+        || action.starts_with("device_")
+        || action.starts_with("stream_")
+}
+
+#[cfg(test)]
